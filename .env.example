# JARVIS local configuration
PORT=3000
JARVIS_HOST=127.0.0.1
JARVIS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# Local Gemma 4 E2B brain via Ollama
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e2b

# Hermes Agent CLI integration
# Local-first mode is the default. Configure Hermes to use Ollama/Gemma with:
# npm run hermes:configure
HERMES_ENABLED=true
HERMES_USE_LOCAL_OLLAMA=true
HERMES_MODEL=gemma4:e2b
HERMES_PROVIDER=custom
HERMES_BASE_URL=http://127.0.0.1:11434/v1
HERMES_CONTEXT_LENGTH=65536
HERMES_OLLAMA_NUM_CTX=65536
HERMES_ALLOW_CLOUD_FALLBACK=false
HERMES_MAX_TURNS=80
HERMES_TIMEOUT_MS=600000
HERMES_TOOLSETS=computer_use,browser,file,terminal,web,memory,skills,session_search
# Keep Hermes fully local by default. Set true only if you intentionally configure a paid/cloud fallback.
# Hermes primary fallbacks are configured in Hermes itself, not through this env var.

# Maximum legacy OpenAI-compatible provider tool-calling rounds per chat turn.
JARVIS_TOOL_MAX_LOOPS=8

# Legacy server-side provider keys (optional)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
HUGGINGFACE_API_KEY=

# Activity intelligence
JARVIS_ACTIVITY_ENABLED=true
JARVIS_ACTIVITY_INTERVAL_MS=3000
JARVIS_PROCESS_INTERVAL_MS=6000
JARVIS_APP_SCAN_INTERVAL_MS=60000
JARVIS_ACTIVITY_MAX_EVENTS=2000
JARVIS_DEVICE_ID=
JARVIS_DEVICE_NAME=
JARVIS_DEVICE_AUTO_REGISTER=true
# Optional extra folders to watch in real time. Separate multiple paths with ;
# Example:
# JARVIS_ACTIVITY_ROOTS=C:\\Projects;D:\\Work
JARVIS_ACTIVITY_ROOTS=

# Optional outbound desktop relay for a cloud JARVIS instance
# Keep disabled unless you deliberately configure an authenticated relay.
JARVIS_RELAY_ENABLED=false
JARVIS_RELAY_TOKEN=
JARVIS_RELAY_MAX_QUEUE=100
# On the Windows desktop relay agent, point this at the cloud server's /api/relay endpoint:
# JARVIS_RELAY_URL=https://your-jarvis-host.example/api/relay
JARVIS_RELAY_POLL_MS=4000

# ==========================================================
# OPTIONAL RENDER CLOUD MODE
# Keep Ollama + Hermes on the Windows desktop; Render is only
# the public UI/API relay. Do not paste desktop secrets here.
# ==========================================================
JARVIS_CLOUD_MODE=false
JARVIS_WEB_TOKEN=
JARVIS_CLOUD_DESKTOP_DEVICE_ID=windows-main
JARVIS_CLOUD_RELAY_WAIT_MS=720000
JARVIS_CLOUD_RELAY_POLL_MS=750
JARVIS_DATA_DIR=./data
