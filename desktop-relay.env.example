# Configure this file on the Windows PC that owns Ollama + Gemma + Hermes.
# The Render service never gets direct access to your local Ollama port.
JARVIS_RELAY_URL=https://YOUR-JARVIS-CLOUD.onrender.com/api/relay
JARVIS_RELAY_TOKEN=PASTE_THE_JARVIS_RELAY_TOKEN_FROM_RENDER
JARVIS_DEVICE_ID=windows-main
JARVIS_DEVICE_NAME=My Windows PC
JARVIS_RELAY_POLL_MS=4000

# The relay agent uses this project's local Hermes + Ollama installation.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e2b
HERMES_ENABLED=true
HERMES_USE_LOCAL_OLLAMA=true
HERMES_MODEL=gemma4:e2b
HERMES_PROVIDER=custom
HERMES_BASE_URL=http://127.0.0.1:11434/v1
HERMES_CONTEXT_LENGTH=65536
HERMES_OLLAMA_NUM_CTX=65536
HERMES_ALLOW_CLOUD_FALLBACK=false
